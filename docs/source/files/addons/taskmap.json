{
  "Name": "taskmap-addon",
  "AutoStart": true,
  "DockerRegistry": {
    "serveraddress": "https://registry.hub.docker.com/v2/"
  },
  "DockerConfig": {
    "Image": "axelwillekens/artof-taskmap-addon:dev",
    "Env": [
      "TASKMAP_POLL_PERIOD=0.2",
      "TASKMAP_FLUSH_PERIOD=1.0",
      "TASKMAP_MIN_DISTANCE=0.1",
      "TASKMAP_POINT_PERIOD=5.0"
    ],
    "HostConfig": {
      "Binds": [
        "/var/lib/ilvo:/var/lib/ilvo"
      ],
      "NetworkMode": "host",
      "RestartPolicy": {
        "Name": "on-failure",
        "MaximumRetryCount": 3
      }
    }
  }
}
